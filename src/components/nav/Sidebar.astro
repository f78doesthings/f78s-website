// The base component for sidebars.

import type { HTMLAttributes } from "astro/types";
import CloseButton from "~icons/fluent/dismiss-20-regular";

interface Props extends HTMLAttributes<"aside"> {
	id: string;

	/** Opens this sidebar from the right instead of the left. */
	right?: boolean;
}

const { id, right = false, class: className, ...props } = Astro.props;
// BUG: resizing the window past a breakpoint causes some styling flashes
---

<aside class:list={["sidebar", className, { right }]} id={id} {...props}>
	<button title="Close" aria-label="Close navigation menu" data-hide-sidebar={id}>
		<CloseButton />
	</button>

	<nav>
		<slot />
	</nav>
</aside>
<div class="backdrop" data-hide-sidebar={id}></div>

<script>
	import { getStorageItem } from "../../scripts/utils/storage-utils";

	const ACTIVE_SIDEBARS_KEY = "activeSidebars";
	const allSidebars: [Element, (force?: boolean) => void][] = [];
	let activeSidebars: string[] = [];
	let isMobile = window.innerWidth < 960;

	function setupSidebars(doc: Document) {
		allSidebars.splice(0);
		activeSidebars =
			getStorageItem<string[]>(
				ACTIVE_SIDEBARS_KEY,
				(value) => Array.isArray(value) && value.every((item) => typeof item === "string"),
			) ?? [];

		const sidebars = doc.querySelectorAll(".sidebar");
		for (const sidebar of sidebars) {
			const toggleSidebar = (force?: boolean) => {
				const open = sidebar.classList.toggle("open", force);
				for (const button of openButtons) {
					button.classList.toggle("active", !isMobile && open);
				}

				if (isMobile) {
					return;
				}

				let changed = false;
				if (open) {
					if (!activeSidebars.includes(sidebar.id)) {
						activeSidebars.push(sidebar.id);
						changed = true;
					}
				} else {
					activeSidebars = activeSidebars.filter((v) => v !== sidebar.id);
					changed = true;
				}

				if (changed) {
					localStorage.setItem(ACTIVE_SIDEBARS_KEY, JSON.stringify(activeSidebars));
				}
			};

			const openButtons = doc.querySelectorAll(`[data-show-sidebar="${sidebar.id}"]`);
			for (const openButton of openButtons) {
				openButton.addEventListener("click", () => toggleSidebar());
			}

			const closeButtons = doc.querySelectorAll(`[data-hide-sidebar="${sidebar.id}"]`);
			for (const closeButton of closeButtons) {
				closeButton.addEventListener("click", () => toggleSidebar(false));
			}

			const links = sidebar.querySelectorAll("[data-hide-sidebar]");
			for (const link of links) {
				link.addEventListener("click", () => {
					if (window.innerWidth < 960) {
						toggleSidebar(false);
					}
				});
			}

			allSidebars.push([sidebar, toggleSidebar]);
			if (!isMobile && activeSidebars.includes(sidebar.id)) {
				toggleSidebar(true);
			}
		}
	}

	window.addEventListener("resize", () => {
		const wasMobile = isMobile;
		isMobile = window.innerWidth < 960;
		if (isMobile === wasMobile) {
			return;
		}

		for (const [sidebar, toggle] of allSidebars) {
			toggle(!isMobile && activeSidebars.includes(sidebar.id));
		}
	});
	document.addEventListener("astro:before-swap", (ev) => setupSidebars(ev.newDocument));
	setupSidebars(document);
</script>

<style lang="scss">
	@use "../../styles/colors" as *;
	@use "../../styles/utils" as *;

	$anim-sidebar-time: 350ms;
	$anim-sidebar: $anim-sidebar-time ease;

	.sidebar {
		position: fixed;
		left: size(-384);
		width: calc(100% - #{size(56)});
		max-width: $sidebar-width;
		height: 100%;

		overflow: hidden;
		visibility: collapse;
		z-index: 2100;
		transition:
			left $anim-sidebar,
			right $anim-sidebar,
			visibility $anim-sidebar-time allow-discrete;

		> nav {
			--shadow-direction: right;
			position: relative;
			display: flex;
			flex-direction: column;
			padding-block: size(12) size(10);
			width: 100%;
			height: 100%;
			background-color: var(--color-component);

			&::after {
				content: "";
				position: absolute;
				left: 100%;
				top: 0;
				width: size(20);
				height: 100%;
				background: linear-gradient(to var(--shadow-direction), hsl(0deg 0% 0% / 5%), transparent);
			}

			@media (prefers-contrast: more) {
				border-right: 1px solid var(--color-border);
			}
		}

		&.open {
			left: 0;
			overflow: visible;
			visibility: visible;
		}

		&.right {
			left: auto;
			right: size(-384);

			&.open {
				right: 0;
			}

			> [data-hide-sidebar] {
				left: auto;
				right: 100%;
			}

			> nav {
				--shadow-direction: left;

				&::after {
					left: auto;
					right: 100%;
				}

				@media (prefers-contrast: more) {
					border-right: none;
					border-left: 1px solid var(--color-border);
				}
			}
		}

		> [data-hide-sidebar] {
			position: absolute;
			left: 100%;
			margin: size(4);
			padding: 0;

			width: size(48);
			height: size(48);
			border-radius: $radius-full;

			display: flex;
			align-items: center;
			justify-content: center;

			background: none;
			border: none;
			color: $red-500;
			cursor: pointer;

			@include preferences("light") {
				color: $red-400;
			}

			@include btn-transparent(true);
		}

		@media print {
			display: none;
		}

		@media not (min-width: $breakpoint-tablet) {
			:root:has(> body > &.open) {
				overflow: hidden;
			}
		}

		@media (min-width: $breakpoint-tablet) {
			position: sticky;
			top: $header-height;
			width: 0;
			height: calc(100dvh - $header-height);
			visibility: visible;
			z-index: 1900;
			transition: width 350ms step-end;

			> nav {
				width: $sidebar-width;
				transform: translateX(-100%);
				visibility: collapse;
				transition:
					transform $anim-sidebar,
					visibility $anim-sidebar-time allow-discrete;
			}

			&.open {
				width: $sidebar-width;
				transition: width $anim-sidebar-time step-start;

				> nav {
					visibility: visible;
					transform: none !important;
				}
			}

			&.right {
				right: 0;

				> nav {
					transform: translateX(100%);
				}
			}

			> [data-hide-sidebar],
			& + .backdrop {
				display: none;
			}

			@media not (prefers-contrast: more) {
				@include preferences("fx") {
					transition: width $anim-sidebar !important;
					z-index: 900;

					> nav {
						background-color: transparent;

						&::before {
							content: "";
							position: absolute;
							top: 0;
							left: 0;
							width: calc(100% + size(16));
							height: 100%;
							z-index: -1;
							backdrop-filter: contrast(97%) brightness(75%) blur(size(3));
							mask: linear-gradient(
								to var(--shadow-direction),
								hsl(0deg 0% 0% / 98%),
								hsl(0deg 0% 0% / 93%) calc(100% - size(18)),
								transparent
							);
						}

						&::after {
							content: none;
						}
					}

					&.right > nav {
						transform: none !important;

						&::before {
							left: auto;
							right: 0;
						}
					}
				}

				@include preferences("fx", "light") {
					> nav::before {
						backdrop-filter: blur(size(2));
					}
				}
			}
		}
	}
</style>
