// Site navigation (top bar and sidebars)

import { SITE_VERSION } from "astro:env/client";

import NavigationIcon from "~icons/fluent/navigation-20-regular";
import TableOfContentsIcon from "~icons/fluent/panel-left-text-20-regular";
import HomeIcon from "~icons/fluent/home-20-regular";
import BlogIcon from "~icons/fluent/rss-20-regular";
import MusicIcon from "~icons/fluent/music-note-2-20-regular";
import GamesIcon from "~icons/fluent/games-20-regular";
import CodeIcon from "~icons/fluent/code-20-regular";
import SettingsIcon from "~icons/fluent/settings-20-regular";

import Badge from "../Badge";
import PreferenceControl from "../preferences/PreferenceControl.astro";
import SiteLogo from "./SiteLogo.astro";
import SidebarLink from "./SidebarLink.astro";
import Sidebar from "./Sidebar.astro";
import TableOfContents, { type Props as TableOfContentsProps } from "./TableOfContents.astro";

type Props = Partial<TableOfContentsProps>;

const { headings, ...props } = Astro.props;

// TODO: add Skip Navigation button (although keyboard navigation is kind of screwed anyway)
---

<header>
	<nav>
		<SidebarLink
			title="Open navigation menu"
			aria-label="Open navigation menu"
			data-show-sidebar="navigation-menu"
		>
			<NavigationIcon />
		</SidebarLink>
		<SiteLogo />
		{
			headings && (
				<SidebarLink
					title="Open table of contents"
					aria-label="Open table of contents"
					data-show-sidebar="headings-menu"
				>
					<TableOfContentsIcon style="transform: rotate(180deg)" />
				</SidebarLink>
			)
		}
	</nav>
</header>

<Sidebar id="navigation-menu">
	<h2>Places</h2>
	<SidebarLink href="/"><HomeIcon /> Home</SidebarLink>
	<SidebarLink href="/blog"><BlogIcon /> Blog</SidebarLink>

	<h2>My hobbies</h2>
	<div class="future-topics">
		<div class="placeholder">
			<SidebarLink href="/hobbies/gaming"><GamesIcon /> Gaming</SidebarLink>
			<SidebarLink href="/hobbies/music"><MusicIcon /> Music</SidebarLink>
			<SidebarLink href="/hobbies/programming"><CodeIcon /> Programming</SidebarLink>
		</div>
		<div class="coming-soon">Coming soon...</div>
	</div>

	<div class="separator"></div>
	<h2>
		Preferences
		<Badge type="beta" />
	</h2>
	<PreferenceControl preference="immersiveMode" showIcon showTitle="Immersive Mode" noMobile />
	<PreferenceControl preference="theme" showIcon showTitle noMobile />
	<SidebarLink href="/preferences">
		<SettingsIcon />
		More Settings
	</SidebarLink>
	<SidebarLink href="/version" class="version">version {SITE_VERSION}</SidebarLink>
</Sidebar>

{
	headings && (
		<Sidebar id="headings-menu" right>
			<h2>Table of Contents</h2>
			<TableOfContents headings={headings} {...props} />
		</Sidebar>
	)
}

<style lang="scss">
	@use "../../styles/colors" as *;
	@use "../../styles/utils" as *;

	// Top bar
	header {
		position: sticky;
		top: 0;
		width: 100%;
		height: $header-height;
		z-index: 1000;
		background-color: var(--color-component);
		box-shadow: $glass-shadow;

		@media print {
			display: none;
		}

		@media (prefers-contrast: more) {
			border-bottom: 1px solid var(--color-border);
		}

		@media not (prefers-contrast: more) {
			@include preferences("fx") {
				background-color: transparent;

				&::before {
					content: "";
					position: absolute;
					top: 0;
					left: 0;
					width: 100%;
					height: calc($header-height + size(16));
					background: linear-gradient(var(--color-page), transparent);
					backdrop-filter: contrast(88%) brightness(33%) blur(size(8));
					mask: linear-gradient(black, hsl(0deg 0% 0% / 99.2%) $header-height, transparent);
				}
			}

			@include preferences("fx", "light") {
				&::before {
					backdrop-filter: contrast(30%) brightness(160%) blur(size(8));
				}
			}
		}

		nav {
			display: flex;
			width: 100%;
			margin: auto;
			padding: 0 size(12);
		}

		a,
		button {
			padding: size(10);
		}

		.site-logo {
			margin-right: auto;
		}

		[data-icon] {
			font-size: size(20);
		}
	}

	button,
	a {
		display: flex;
		align-items: center;

		background: none;
		border: none;

		color: var(--color-heading);
		text-decoration: none;

		cursor: pointer;

		@include btn-transparent;

		@include preferences("light") {
			color: var(--color-heading);
		}
	}

	// Sidebar
	.sidebar {
		:where(h2, a, label) {
			padding: size(10) $page-margin;
		}

		:not(.badge) > [data-icon] {
			font-size: size(30);
		}

		h2 {
			display: flex;
			align-items: center;
			gap: size(8);

			margin: 0;
			padding-block: 0;
			min-height: $badge-height;

			font-weight: 400;
			font-size: size(16);
			color: color-mix(in oklch, var(--color-dim), var(--color-dimmer));

			:global(.badge) {
				color: var(--color-text);
			}

			&:not(:first-of-type) {
				margin-top: size(8);
			}
		}
	}

	#navigation-menu {
		> :global(nav) {
			overflow: hidden auto;
		}

		.separator {
			flex-grow: 1;
		}

		.future-topics {
			position: relative;
			user-select: none;

			.placeholder {
				pointer-events: none;
				color: var(--color-dimmer);
				filter: blur(size(1.2));

				> * {
					color: inherit;
				}
			}

			.coming-soon {
				position: absolute;
				inset: 0;

				display: flex;
				align-items: center;
				justify-content: center;

				text-shadow: 0 size(1) size(8) var(--color-page);
			}

			@include preferences("fx") {
				.placeholder,
				.coming-soon {
					transition: all 375ms $ease-out-cubic;
				}

				.placeholder {
					color: var(--color-text);
					filter: blur(size(8));
					opacity: 1;
				}

				.coming-soon {
					color: var(--color-heading);
					opacity: 0.9;
				}

				@include hover-or-active {
					.placeholder {
						filter: blur(size(1.1));
						opacity: 0.65;
					}

					.coming-soon {
						filter: blur(size(6));
						opacity: 0.75;
					}
				}
			}
		}

		.version {
			font-size: size(14);
			color: var(--color-dimmer);
			padding-block: size(5);
		}
	}

	#headings-menu {
		> :global(nav) {
			padding-bottom: 0;
		}
	}
</style>
