// Site navigation (top bar and sidebar)

import type { MarkdownHeading } from "astro";
import { SITE_VERSION } from "astro:env/client";

import NavigationIcon from "~icons/fluent/navigation-20-regular";
import TableOfContentsIcon from "~icons/fluent/panel-left-text-20-regular";
import HomeIcon from "~icons/fluent/home-20-regular";
import BlogIcon from "~icons/fluent/rss-20-regular";
import MusicIcon from "~icons/fluent/music-note-2-20-regular";
import GamesIcon from "~icons/fluent/games-20-regular";
import CodeIcon from "~icons/fluent/code-20-regular";
import SettingsIcon from "~icons/fluent/settings-20-regular";

import Badge from "../Badge";
import PreferenceControl from "../preferences/PreferenceControl.astro";
import SiteLogo from "./SiteLogo.astro";
import SidebarLink from "./SidebarLink.astro";
import Sidebar from "./Sidebar.astro";

interface Props {
	headings?: MarkdownHeading[];
}

const { headings } = Astro.props;

// TODO: add Skip Navigation button (although keyboard navigation is kind of screwed anyway)
---

<header>
	<nav>
		<SidebarLink
			title="Open navigation menu"
			aria-label="Open navigation menu"
			data-show-sidebar="navigation-menu"
		>
			<NavigationIcon />
		</SidebarLink>
		<SiteLogo />
		{
			headings && (
				<SidebarLink
					title="Open table of contents"
					aria-label="Open table of contents"
					data-show-sidebar="headings-menu"
				>
					<TableOfContentsIcon style="transform: rotate(180deg)" />
				</SidebarLink>
			)
		}
	</nav>
</header>

<Sidebar id="navigation-menu">
	<h2>Places</h2>
	<SidebarLink href="/"><HomeIcon /> Home</SidebarLink>
	<SidebarLink href="/blog"><BlogIcon /> Blog</SidebarLink>

	<h2>Topics</h2>
	<div class="topics">
		<div class="placeholder">
			<SidebarLink><MusicIcon /> Music</SidebarLink>
			<SidebarLink><GamesIcon /> Gaming</SidebarLink>
			<SidebarLink><CodeIcon /> Programming</SidebarLink>
		</div>
		<div class="coming-soon">Coming soon...</div>
	</div>

	<div class="separator"></div>
	<h2>
		Preferences
		<Badge type="beta" />
	</h2>
	<PreferenceControl preference="immersiveMode" showIcon showTitle="Immersive Mode" noMobile />
	<PreferenceControl preference="theme" showIcon showTitle noMobile />
	<SidebarLink href="/preferences">
		<SettingsIcon />
		More Settings
	</SidebarLink>
	<SidebarLink href="/version" class="version">version {SITE_VERSION}</SidebarLink>
</Sidebar>

{
	headings && (
		<Sidebar id="headings-menu" right>
			{headings && <h2>Table of Contents</h2>}
			<div class="table-of-contents">
				<SidebarLink href="#top" class="depth-1">
					(Top)
				</SidebarLink>

				{/* TODO: This should really be represented as nested ordered lists, but maybe later. */}
				{headings.map(({ depth, slug, text }) => {
					return (
						<SidebarLink href={`#${slug}`} class={`depth-${depth}`} data-slug={slug}>
							{text}
						</SidebarLink>
					);
				})}
			</div>
		</Sidebar>
	)
}

<script>
	const TIME_BETWEEN_HEADING_UPDATES = 500;

	let tableOfContents: HTMLElement | null;
	let headings: [HTMLAnchorElement, HTMLElement][] = [];
	let currentHeading = "";
	let lastHeadingUpdate = 0;
	let justNavigated = true;
	let handle: number | undefined;

	// TODO: add a button to scroll the active link into view when it's offscreen

	document.addEventListener("astro:page-load", () => {
		tableOfContents = document.querySelector(".table-of-contents");
		if (!tableOfContents) {
			return;
		}

		const contents = tableOfContents.querySelectorAll<HTMLAnchorElement>("a");
		headings = [];
		for (const item of contents) {
			const slug = item.dataset.slug;
			const heading = document.querySelector<HTMLElement>(
				slug ? `main #${slug}` : "main > article > header",
			);
			if (heading) {
				headings.push([item, heading]);
			}
		}

		currentHeading = location.hash.substring(1);
		justNavigated = true;
		updateHeadings();
		justNavigated = false;
	});

	function updateHeadings() {
		// Find the last link that hasn't gone off the top of the screen
		const scrollPadding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop);
		const activeIndex =
			headings.findIndex(
				([, heading]) => heading.getBoundingClientRect().top >= scrollPadding + 100,
			) - 1;
		const [activeLink, activeHeading] = headings[activeIndex] ?? [];

		// Update the sidebar links
		for (const [link, heading] of headings) {
			const rect = heading.getBoundingClientRect();
			const isOnScreen = rect.bottom >= 0 && rect.top <= document.documentElement.clientHeight;
			link.classList.toggle("active", link === activeLink || isOnScreen);

			// If the browser didn't feel like scrolling the heading into view, then do so manually
			if (justNavigated && currentHeading && heading.id === currentHeading && window.scrollY < 1) {
				console.info(`Forcefully scrolling heading "${link.hash}" into view`);
				heading.scrollIntoView();
			}
		}

		if (justNavigated || activeHeading === undefined || currentHeading === activeHeading.id) {
			return;
		}

		// Update the address bar hash
		// Browsers don't like it when we spam the History API, so we need to throttle it here
		// TODO: make a throttle utility for stuff like this (including logging)
		const now = Date.now();
		const timeSinceUpdate = now - lastHeadingUpdate;
		currentHeading = activeHeading.id;
		clearTimeout(handle);

		if (timeSinceUpdate >= TIME_BETWEEN_HEADING_UPDATES) {
			setHeading(activeHeading.id);
		} else {
			handle = window.setTimeout(
				() => setHeading(activeHeading.id),
				TIME_BETWEEN_HEADING_UPDATES - timeSinceUpdate,
			);
		}
	}

	function setHeading(id: string) {
		const hash = `#${id}`;
		if (location.hash !== hash) {
			lastHeadingUpdate = Date.now();
			history.replaceState(null, "", hash);
		}
	}

	document.addEventListener("scroll", updateHeadings);
</script>

<style lang="scss">
	@use "../../styles/colors" as *;
	@use "../../styles/utils" as *;
	@use "sass:color";
	@use "sass:map";
	@use "sass:list";
	@use "sass:math";

	// Top bar
	header {
		position: sticky;
		top: 0;
		width: 100%;
		height: $header-height;
		z-index: 1000;
		background-color: var(--color-component);

		@media print {
			display: none;
		}

		@media (prefers-contrast: more) {
			border-bottom: 1px solid var(--color-border);
		}

		@include glass;

		@include preferences("fx") {
			background-color: color-mix(in srgb, var(--color-component), transparent 12%);
		}

		nav {
			display: flex;
			width: 100%;
			margin: auto;
			padding: 0 size(12);
		}

		a,
		button {
			padding: size(10);
		}

		.site-logo {
			margin-right: auto;
		}

		[data-icon] {
			font-size: size(20);
		}
	}

	button,
	a {
		display: flex;
		align-items: center;

		background: none;
		border: none;

		color: var(--color-heading);
		text-decoration: none;

		cursor: pointer;

		@include btn-transparent;

		@include preferences("light") {
			color: var(--color-heading);
		}
	}

	// Sidebar
	.sidebar {
		:where(h2, a, label) {
			padding: size(10) $page-margin;
		}

		:not(.badge) > [data-icon] {
			font-size: size(30);
		}

		h2 {
			display: flex;
			align-items: center;
			gap: size(8);

			margin: 0;
			padding-block: 0;
			min-height: $badge-height;

			font-weight: 400;
			font-size: size(16);
			color: color-mix(in oklch, var(--color-dim), var(--color-dimmer));

			:global(.badge) {
				color: var(--color-text);
			}

			&:not(:first-of-type) {
				margin-top: size(8);
			}
		}
	}

	#navigation-menu {
		.separator {
			flex-grow: 1;
		}

		.topics {
			position: relative;
			user-select: none;

			.placeholder {
				pointer-events: none;
				color: var(--color-dimmer);
				filter: blur(size(1.2));

				> * {
					color: inherit;
				}
			}

			.coming-soon {
				position: absolute;
				inset: 0;

				display: flex;
				align-items: center;
				justify-content: center;

				text-shadow: 0 size(1) size(8) var(--color-page);
			}

			@include preferences("fx") {
				.placeholder,
				.coming-soon {
					transition: all 375ms $ease-out-cubic;
				}

				.placeholder {
					color: var(--color-text);
					filter: blur(size(8));
					opacity: 1;
				}

				.coming-soon {
					opacity: 0.9;
				}

				@include hover-or-active {
					.placeholder {
						filter: blur(size(1.1));
						opacity: 0.65;
					}

					.coming-soon {
						filter: blur(size(6));
						opacity: 0.75;
					}
				}
			}
		}

		.version {
			font-size: size(14);
			color: var(--color-dimmer);
			padding-block: size(5);
		}
	}

	// Table of contents
	@mixin toc-depth($depth) {
		$font-weight: list.nth(400 385 360 335 315 300, $depth);
		$color-step: list.nth(50 100 200 250 300 325, $depth);
		$margin: size(5);

		&.depth-#{$depth} {
			padding: $margin $page-margin $margin calc($page-margin * ($depth + 1) / 2);
			font-weight: $font-weight;
			color: map.get($colors-taupe, $color-step);

			@include preferences("light") {
				color: map.get($colors-zinc, 1000 - $color-step);
			}

			@media (prefers-contrast: more) {
				color: var(--color-text);
			}

			@if $depth > 1 {
				@for $upper-depth from 1 through $depth - 1 {
					+ .depth-#{$upper-depth} {
						margin-top: $margin;

						& :global(.highlight) {
							height: calc(100% + $margin);
						}
					}
				}
			}
		}
	}

	#headings-menu {
		padding-bottom: 0;

		.table-of-contents {
			position: relative;
			margin-top: size(6);
			padding-bottom: size(10);
			flex-grow: 1;
			overflow-y: auto;

			a {
				@for $depth from 1 through 6 {
					@include toc-depth($depth);
				}
			}
		}
	}
</style>
