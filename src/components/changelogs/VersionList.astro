import type { VersionInfo } from "../../types";
import FormattedDate from "../FormattedDate.astro";

import LatestIcon from "~icons/fluent/new-16-regular";
import Markdown from "../utils/Markdown.astro";
import { PRERELEASE_TYPES } from "../../consts";

type Props = {
	versions: VersionInfo[];
};

const { versions } = Astro.props;
let firstPrerelease = true;
let firstStable = true;
---

<ol class="version-list">
	{
		versions.map((v) => {
			const latest = v.prerelease ? firstPrerelease : firstStable;
			if (v.prerelease) {
				firstPrerelease = false;
			} else {
				firstStable = false;
			}

			const Icon = v.prerelease ? PRERELEASE_TYPES[v.prerelease].iconSmall : () => {};
			return (
				<li
					data-preference-dependencies={v.prerelease ? '[["showPrerelease", [true]]]' : undefined}
					data-ignore-preference-availability={v.prerelease ? "" : undefined}
					hidden={v.prerelease}
					class:list={{ prerelease: v.prerelease, latest }}
				>
					<a href={`/version/${v.id}`} class="version">
						{v.id}
					</a>
					{latest && (
						<span class="badge badge-latest" title="Latest version">
							<LatestIcon />
						</span>
					)}
					{v.prerelease && (
						<span
							class={`badge badge-${v.prerelease}`}
							title={PRERELEASE_TYPES[v.prerelease].title}
						>
							<Icon />
						</span>
					)}
					<div class="separator" />
					<FormattedDate date={v.date} />
					{v.message && (
						<div class="message">
							<Markdown content={v.message} />
						</div>
					)}
				</li>
			);
		})
	}
</ol>

<style lang="scss">
	@use "../../styles/utils" as *;
	@use "../../styles/colors" as *;
	@use "sass:map";

	@mixin version-badge($colors) {
		--badge-background: #{map.get($colors, 600)};
		border-color: map.get($colors, 500);
		color: map.get($colors, 50);

		@include preferences("light") {
			--badge-background: #{map.get($colors, 400)};
			border-color: map.get($colors, 600);
			color: map.get($colors, 950);
		}
	}

	.version-list {
		padding: 0;

		> li {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			list-style: none;
			gap: 0 size(8);
			margin: 0 0 size(2);

			&[hidden] {
				display: none;
			}

			.separator {
				flex-grow: 1;
			}

			&.latest {
				font-size: size(18);
				margin-bottom: size(6);

				.message {
					font-size: size(16);
				}
			}

			.badge {
				display: flex;
				align-items: center;
				justify-content: center;
				width: size(24);
				height: size(24);

				background-color: color-mix(in srgb, var(--badge-background), transparent 80%);
				border: 1px solid transparent;
				border-radius: $radius-full;

				[data-icon] {
					font-size: size(16);
					margin: 0;
				}

				&.badge-latest {
					@include version-badge($colors-red);
				}

				&.badge-dev {
					@include version-badge($colors-pink);
				}

				&.badge-alpha {
					@include version-badge($colors-fuchsia);
				}

				&.badge-beta {
					@include version-badge($colors-violet);
				}

				&.badge-rc {
					@include version-badge($colors-blue);
				}
			}

			.formatted-date {
				font-size: size(14);

				:global([data-icon]) {
					font-size: size(20);
				}
			}

			&.prerelease {
				opacity: 0.78;

				@media (prefers-contrast: more) {
					opacity: 0.88;
				}
			}

			.message {
				width: 100%;
				margin-block: size(4);
				font-size: size(14);
				color: var(--color-dim);

				:global(> :first-child) {
					margin-top: 0;
				}

				:global(> :last-child) {
					margin-bottom: 0;
				}
			}
		}
	}
</style>
