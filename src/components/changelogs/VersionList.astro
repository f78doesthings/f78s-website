import type { VersionInfo } from "../../types";
import FormattedDate from "../utils/FormattedDate.astro";

import Markdown from "../utils/Markdown.astro";
import { PRERELEASE_TYPES, UPDATE_SIZES } from "../../consts";
import { getChangelogs } from "../../server-utils";

type Props = {
	versions: VersionInfo[];
};

const { versions } = Astro.props;
const firstPrerelease = versions.find((v) => v.prerelease);
const firstStable = versions.find((v) => !v.prerelease);
---

<ol class="version-list">
	{
		versions.map(async (v) => {
			const latest = v === firstStable || v === firstPrerelease;
			const changelogs = await getChangelogs(v.id);
			const updateSize = changelogs?.data.size;

			const SizeIcon = updateSize ? UPDATE_SIZES[updateSize].icon : () => {};
			const PrereleaseIcon = v.prerelease ? PRERELEASE_TYPES[v.prerelease].icon : () => {};

			return (
				<li
					data-preference-dependencies={v.prerelease ? '[["showPrerelease", [true]]]' : undefined}
					data-ignore-preference-availability={v.prerelease ? "" : undefined}
					hidden={v.prerelease}
					class:list={[
						updateSize && `update-size-${updateSize}`,
						v.prerelease && `prerelease-${v.prerelease}`,
						{ prerelease: v.prerelease, latest },
					]}
					id={`version-list_${v.id}`}
				>
					<a href={`/version/${v.id}`}>
						<div class="header">
							<h3 class="version">
								{v.id}
								{changelogs?.data.title && (
									<>
										{" "}
										<small>
											&OpenCurlyDoubleQuote;{changelogs.data.title}&CloseCurlyDoubleQuote;
										</small>
									</>
								)}
							</h3>
							<ul class="details">
								{updateSize && (
									<li class="update-size">
										<SizeIcon />{" "}
										{UPDATE_SIZES[updateSize][v.prerelease ? "shortTitle" : "longTitle"]}
									</li>
								)}
								{v.prerelease && updateSize && <li class="separator">&bullet;</li>}
								{v.prerelease && (
									<li
										class={`prerelease prerelease-${v.prerelease}`}
										title={PRERELEASE_TYPES[v.prerelease].description}
									>
										<PrereleaseIcon /> {PRERELEASE_TYPES[v.prerelease].shortTitle}
									</li>
								)}
							</ul>
							<FormattedDate date={v.date} />
						</div>
						{v.message && (
							<div class="message">
								<Markdown content={v.message} />
							</div>
						)}
					</a>
				</li>
			);
		})
	}
</ol>

<style lang="scss">
	@use "../../styles/utils" as *;
	@use "../../styles/colors" as *;
	@use "sass:map";
	@use "sass:color";
	@use "sass:math";

	@mixin variables($type, $colors) {
		$alpha: 0.185;

		@if $type == "prerelease" {
			$alpha: 0.125;
		}

		--#{$type}-color: #{map.get($colors, 375)};
		--#{$type}-background: #{color.change(map.get($colors, 500), $alpha: $alpha)};

		@media (prefers-contrast: more) {
			--#{$type}-color: #{map.get($colors, 250)};
		}

		@include preferences("light") {
			--#{$type}-color: #{map.get($colors, 675)};
			--#{$type}-background: #{color.change(map.get($colors, 400), $alpha: $alpha)};

			@media (prefers-contrast: more) {
				--#{$type}-color: #{map.get($colors, 800)};
			}
		}
	}

	.version-list {
		$padding: size(14, true);
		margin-block: 0 $padding;
		padding: 0;

		> li {
			--update-background: var(--color-component);
			--prerelease-background: transparent;
			list-style: none;
			margin: 0 size(-6);
			padding-top: $padding;
			font-size: size(18, true);

			// Add shadows to improve legibility
			--shadow-color: hsl(0deg 0% 0% / 70%);
			$shadow: 0 #{size(1)} #{size(4)};
			text-shadow: $shadow var(--shadow-color);

			[data-icon] {
				filter: drop-shadow($shadow var(--shadow-color));
				font-size: size(20);
			}

			@media (prefers-contrast: more) {
				--shadow-color: black;
			}

			@include preferences("light") {
				--shadow-color: hsl(0deg 0% 100% / 30%);

				@media (prefers-contrast: more) {
					--shadow-color: hsl(0deg 0% 100% / 50%);
				}
			}

			> a {
				position: relative;
				display: block;
				padding: $padding;

				font-weight: 400;
				text-decoration-line: none;
				color: inherit;

				background-image: radial-gradient(
					at top left in oklch,
					var(--update-background),
					var(--prerelease-background)
				);
				border-radius: $padding;

				&::before {
					content: "";
					position: absolute;
					inset: 0;
					border: 1px solid white;
					border-radius: inherit;
					mask: linear-gradient(rgb(0 0 0 / 13%), rgb(0 0 0 / 7%));
					pointer-events: none;

					@media (prefers-contrast: more) {
						mask: linear-gradient(rgb(0 0 0 / 35%), rgb(0 0 0 / 35%));
					}
				}

				@include btn-transparent;

				@include preferences("light") {
					&::before {
						border-color: black;
					}
				}
			}

			.header {
				display: grid;
				grid-template:
					"title   title"
					"details date"
					/ 1fr auto;
				gap: calc($padding / 2);
				align-items: end;

				&:not(:has(.details:not(:empty))) {
					grid-template-areas: "title date";
				}
			}

			.version {
				grid-area: title;
				font-size: size(18, true);
				margin: 0;

				> small {
					color: var(--color-dim);
					font-weight: 400;
				}
			}

			.formatted-date {
				grid-area: date;
				color: var(--color-text);
				margin: 0;
				margin-left: auto;
				font-size: size(14, true);

				:global([data-icon]) {
					font-size: size(20);
				}
			}

			.details {
				grid-area: details;

				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0 size(6, true);
				font-size: size(14, true);

				padding: 0;
				list-style: none;

				&:empty {
					display: none;
				}

				li {
					margin: 0;
				}

				.separator {
					opacity: 0.5;
					line-height: 1;
				}

				.update-size {
					color: var(--update-color);
					font-weight: 500;
				}

				.prerelease {
					color: var(--prerelease-color);
					font-weight: 450;
				}
			}

			&[hidden] {
				display: none;
			}

			&.latest {
				font-size: size(18);
				padding-bottom: $padding;
				border-bottom: 1px solid var(--color-border);

				@media not (prefers-contrast: more) {
					border-image: linear-gradient(
							90deg,
							transparent -50%,
							var(--color-border) 50%,
							transparent 150%
						)
						1;
				}
			}

			&.prerelease {
				margin-left: size(10);
				font-size: size(16, true);

				&.update-size-hotfix,
				&.update-size-minor {
					font-size: size(14, true);
				}
			}

			&.update-size-hotfix,
			&.update-size-minor {
				font-size: size(16, true);
			}

			.message {
				--border: hsl(0deg 0% 100% / 35%);

				width: 100%;
				font-size: size(14, true);
				color: var(--color-dim);

				margin-top: calc($padding / 2);
				padding-top: calc($padding / 2);
				border-top: 1px solid var(--border);

				@media not (prefers-contrast: more) {
					--border: hsl(0deg 0% 100% / 20%);
					border-image: linear-gradient(
							90deg,
							transparent -50%,
							var(--border) 50%,
							transparent 150%
						)
						1;
				}

				@include preferences("light") {
					--border: hsl(0deg 0% 0% / 35%);

					@media not (prefers-contrast: more) {
						--border: hsl(0deg 0% 0% / 20%);
					}
				}

				:global(> :first-child) {
					margin-top: 0;
				}

				:global(> :last-child) {
					margin-bottom: 0;
				}
			}

			&.update-size-hotfix {
				@include variables("update", $colors-slate);
			}

			&.update-size-minor {
				@include variables("update", $colors-red);
			}

			&.update-size-regular {
				@include variables("update", $colors-yellow);
			}

			&.update-size-major {
				@include variables("update", $colors-green);
			}

			&.prerelease-dev {
				@include variables("prerelease", $colors-rose);
			}

			&.prerelease-alpha {
				@include variables("prerelease", $colors-fuchsia);
			}

			&.prerelease-beta {
				@include variables("prerelease", $colors-indigo);
			}

			&.prerelease-rc {
				@include variables("prerelease", $colors-blue);
			}
		}
	}
</style>
