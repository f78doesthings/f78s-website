// Displays a banner on the top of the page.

interface Props {
	/**
	 * The ID of the banner, used to remember which banners have been dismissed by the user.
	 *
	 * If this is omitted, the banner cannot be hidden.
	 */
	id?: string;
}

const { id } = Astro.props;
---

<div data-banner={id ?? ""} class:list={{ visible: id === undefined }}>
	<slot />
	{
		id && (
			<button>
				<slot name="dismiss-button">Got it!</slot>
			</button>
		)
	}
</div>

<script>
	import { defineDevTool } from "../scripts/utils/dev-tools";
	import { getStorageItem } from "../scripts/utils/storage-utils";

	const DISMISSED_BANNERS_KEY = "dismissedBanners";

	function setupBanners() {
		const banners = document.querySelectorAll<HTMLElement>("[data-banner]");
		const dismissedBanners =
			getStorageItem<string[]>(
				DISMISSED_BANNERS_KEY,
				(value) => Array.isArray(value) && value.every((item) => typeof item === "string"),
			) ?? [];

		for (const banner of banners) {
			const bannerButton = banner?.querySelector("button");
			const id = banner.dataset.banner;
			if (!bannerButton || !id) {
				// The banner is not dismissible
				continue;
			}

			if (!dismissedBanners.includes(id)) {
				banner.classList.add("visible");
				bannerButton.addEventListener(
					"click",
					() => {
						banner.classList.remove("visible");
						dismissedBanners.push(id);
						localStorage.setItem(DISMISSED_BANNERS_KEY, JSON.stringify(dismissedBanners));
					},
					{ once: true },
				);
			}
		}
	}

	document.addEventListener("astro:after-swap", setupBanners);
	setupBanners();
	defineDevTool("resetBanners", () => {
		localStorage.removeItem(DISMISSED_BANNERS_KEY);
		console.info("Successfully reset dismissed banners. Refresh to see the effect.");
	});
</script>

<style lang="scss">
	@use "../styles/utils" as *;
	@use "../styles/colors" as *;
	@use "sass:color";

	[data-banner] {
		$banner-alpha: 88%;

		position: sticky;
		top: $header-height;

		width: 100%;
		display: none;
		align-items: center;
		justify-content: center;

		gap: size(8);
		padding: size(10) $page-margin;
		margin: 0 (-$page-margin);
		z-index: 1900;

		background: linear-gradient(
			color.change($red-850, $alpha: $banner-alpha),
			color.change($red-925, $alpha: $banner-alpha)
		);

		@media screen {
			&.visible {
				display: flex;

				:global(header):has(+ &) {
					box-shadow: none;
				}
			}
		}

		> :global([data-icon]) {
			flex-shrink: 0;
			font-size: size(20);
		}

		:global(a) {
			color: var(--color-heading);
			transition: filter $anim-ease;

			@include hover {
				filter: brightness(87%);
			}

			@include active {
				filter: brightness(78%);
			}

			@include preferences("light") {
				color: var(--color-heading);

				@include hover {
					color: var(--color-dim);
				}

				@include active {
					color: var(--color-text);
				}
			}
		}

		button {
			--hover-text: #{$red-950};

			padding: size(4) size(10);
			flex-shrink: 0;

			background-color: transparent;
			border: 1px solid color-mix(in srgb, var(--color-heading), transparent 50%);
			border-radius: $radius-full;
			font-weight: 500;

			transition:
				background-color $anim-ease,
				color $anim-ease,
				border-color $anim-ease;
			cursor: pointer;

			@include hover {
				background-color: color-mix(in srgb, var(--color-heading), transparent 15%);
				color: var(--hover-text);
			}

			@include active {
				background-color: color-mix(in srgb, var(--color-heading), transparent 40%);
				color: var(--hover-text);
			}
		}

		@include glass;
		box-shadow: none;

		&::after {
			content: "";
			position: absolute;
			top: 100%;
			left: 0;
			width: 100%;
			height: size(20);
			background: linear-gradient(hsl(0deg 0% 0% / 5%), transparent);
		}

		@include preferences("light") {
			background: linear-gradient(
				color.change($red-200, $alpha: $banner-alpha),
				color.change($red-250, $alpha: $banner-alpha)
			);

			button {
				--hover-text: #{$red-150};
			}
		}
	}
</style>
