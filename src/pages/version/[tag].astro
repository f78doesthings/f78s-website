import type { GetStaticPaths } from "astro";

import { PRERELEASE_TYPES } from "../../consts";
import { getChangelogs, getVersions } from "../../server-utils";
import type { VersionInfo } from "../../types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChangelogEntry from "../../components/changelogs/ChangelogEntry.astro";
import FormattedDate from "../../components/utils/FormattedDate.astro";

import BackIcon from "~icons/fluent/arrow-left-24-regular";
import PrevStableIcon from "~icons/fluent/chevron-left-24-regular";
import NextStableIcon from "~icons/fluent/chevron-right-24-regular";
import PrevPrereleaseIcon from "~icons/fluent/chevron-circle-left-24-regular";
import NextPrereleaseIcon from "~icons/fluent/chevron-circle-right-24-regular";
import Alert from "../../components/ui/Alert.astro";
import { render } from "astro:content";

export const getStaticPaths = (async () => {
	const versions = await getVersions();
	return versions.map((v) => ({
		params: { tag: v.id },
		props: v satisfies Props,
	}));
}) satisfies GetStaticPaths;

type Props = VersionInfo;

const {
	id: version,
	message,
	prerelease,
	date,
	prevStable,
	nextStable,
	prevPrerelease,
	nextPrerelease,
	stableCommits,
	prereleaseCommits,
} = Astro.props;
const commits = prereleaseCommits ?? stableCommits;
const olderCommits =
	prereleaseCommits &&
	stableCommits &&
	commits &&
	stableCommits.slice(
		stableCommits.findLastIndex((commit) => commits.some((other) => other.hash === commit.hash)) +
			1,
	);

const changelogs = await getChangelogs(version);
const { Content } = changelogs ? await render(changelogs) : {};
---

<BaseLayout title={`Changelog for v${version}`}>
	<nav>
		<a href="/version#version-list"><BackIcon /> Back to version list</a>
	</nav>

	<h1>
		Version {version}{
			changelogs?.data.title && (
				<>
					{" "}
					<small>&OpenCurlyDoubleQuote;{changelogs.data.title}&CloseCurlyDoubleQuote;</small>
				</>
			)
		}
	</h1>
	<ul class="details">
		<li>
			<FormattedDate date={date} showTime>
				<Fragment slot="before">Released</Fragment>
			</FormattedDate>
		</li>
	</ul>

	{prerelease && <Alert type={prerelease}>{PRERELEASE_TYPES[prerelease].description}</Alert>}
	{
		Content ? (
			<section>
				<h2>Release notes</h2>
				<Content />
			</section>
		) : (
			message
		)
	}

	<h2>Commits</h2>
	{
		commits && commits.length > 0 ? (
			<details open={changelogs === undefined}>
				<summary>View commit history</summary>
				{commits.map((commit) => (
					<ChangelogEntry commit={commit} />
				))}
				{olderCommits && olderCommits.length > 0 && (
					<details>
						<summary>
							View older commits <span class="older-since">(since {prevStable})</span>
						</summary>
						{olderCommits.map((commit) => (
							<ChangelogEntry commit={commit} />
						))}
					</details>
				)}
			</details>
		) : (
			<Alert type="warning">
				This version does not have any commits associated with it.
				<br />
				<small>
					If you see this on an actual production website (development build or not), something
					must've gone very wrong!
				</small>
			</Alert>
		)
	}

	<nav>
		{
			prevStable && (
				<a href={`/version/${prevStable}`} class="prev-stable">
					<PrevStableIcon /> {prevStable}
				</a>
			)
		}
		{
			prevPrerelease && (
				<a
					href={`/version/${prevPrerelease}`}
					data-preference-dependencies={'[["showPrerelease",[true]]]'}
					data-ignore-preference-availability
					class="prev-prerelease"
				>
					<PrevPrereleaseIcon /> {prevPrerelease}
				</a>
			)
		}
		{
			nextPrerelease && (
				<a
					href={`/version/${nextPrerelease}`}
					data-preference-dependencies={'[["showPrerelease",[true]]]'}
					data-ignore-preference-availability
					class="next-prerelease"
				>
					{nextPrerelease} <NextPrereleaseIcon />
				</a>
			)
		}
		{
			nextStable && (
				<a href={`/version/${nextStable}`} class="next-stable">
					{nextStable} <NextStableIcon />
				</a>
			)
		}
	</nav>
</BaseLayout>

<style lang="scss">
	@use "../../styles/utils" as *;
	@use "../../styles/colors" as *;

	h1 > small {
		color: var(--color-text);
		font-size: size(24);
		font-weight: 400;
		font-style: italic;
		display: inline-block;
		line-height: 1.15;
	}

	.details {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: size(6);
		padding: 0;
		list-style: none;

		> li,
		> li > p {
			margin: 0;
		}

		[data-icon] {
			font-size: size(20);
		}

		.separator {
			color: var(--color-dimmer);
		}

		.prerelease {
			color: $amber-300;

			@include preferences("light") {
				color: $yellow-700;
			}
		}
	}

	.older-since {
		font-weight: 400;
		color: var(--color-dim);
	}

	nav {
		display: grid;
		grid-template:
			"prev-stable     next-stable"
			"prev-prerelease next-prerelease";
		justify-content: space-between;
		flex-wrap: wrap;
		margin-block: size(16);

		&:first-child {
			margin-bottom: 0;
		}

		&:last-child {
			margin-top: 0;
		}

		a {
			display: flex;
			align-items: center;
			gap: size(6);
			padding-block: size(6);

			[data-icon] {
				font-size: size(24);
			}

			&[hidden] {
				display: none;
			}
		}

		.prev-stable {
			grid-area: prev-stable;
		}

		.next-stable {
			grid-area: next-stable;
		}

		.prev-prerelease {
			grid-area: prev-prerelease;
		}

		.next-prerelease {
			grid-area: next-prerelease;
		}

		.prev-prerelease,
		.next-prerelease {
			opacity: 0.78;

			@media (prefers-contrast: more) {
				opacity: 0.88;
			}
		}

		.next-stable,
		.next-prerelease {
			justify-self: flex-end;
		}
	}
</style>
