import type { GetStaticPaths } from "astro";

import { IS_DEV } from "../../consts";
import { getVersions } from "../../server-utils";
import type { VersionInfo } from "../../types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChangelogEntry from "../../components/changelogs/ChangelogEntry.astro";
import FormattedDate from "../../components/FormattedDate.astro";

import PrereleaseIcon from "~icons/fluent/wrench-20-regular";
import BackIcon from "~icons/fluent/arrow-left-24-regular";
import PreviousIcon from "~icons/fluent/chevron-left-24-regular";
import NextIcon from "~icons/fluent/chevron-right-24-regular";

export const getStaticPaths = (async () => {
	const versions = await getVersions();
	return versions
		.filter((v) => !v.prerelease || IS_DEV)
		.map((v) => ({
			params: { tag: v.id },
			props: v satisfies Props,
		}));
}) satisfies GetStaticPaths;

type Props = VersionInfo;

const version = Astro.props;
const commits = version.prereleaseCommits ?? version.stableCommits;
const olderCommits =
	version.prereleaseCommits &&
	version.stableCommits.slice(
		version.stableCommits.findLastIndex((commit) =>
			commits.some((other) => other.hash === commit.hash),
		) + 1,
	);

const prevVersion = version.prerelease
	? (version.prevPrerelease ?? version.prevStable)
	: version.prevStable;

const nextVersion = version.prerelease
	? (version.nextPrerelease ?? version.nextStable)
	: version.nextStable;
---

<BaseLayout title={`Changelog for v${version.id}`}>
	<nav>
		<a href="/version#version-list"><BackIcon /> Back to version list</a>
	</nav>

	<h1>Version {version.id}</h1>
	<ul class="details">
		<li>
			<FormattedDate date={version.date} showTime>
				<Fragment slot="before">Dated</Fragment>
			</FormattedDate>
		</li>
		{
			version.prerelease && (
				<li class="separator">&bullet;</li>
				<li class="prerelease">
					<PrereleaseIcon /> Pre-release
				</li>
			)
		}
	</ul>

	<section>
		<h2>Changelog</h2>
		{commits.map((commit) => <ChangelogEntry commit={commit} />)}
		{
			olderCommits && olderCommits.length > 0 && (
				<details>
					<summary>
						View older changes <span class="older-since">(since {version.prevStable})</span>
					</summary>
					{olderCommits.map((commit) => (
						<ChangelogEntry commit={commit} />
					))}
				</details>
			)
		}
	</section>

	{/* TODO: split this navbar into stable and pre-release */}
	<nav>
		{
			prevVersion && (
				<a href={prevVersion}>
					<PreviousIcon /> Previous version ({prevVersion})
				</a>
			)
		}
		{
			nextVersion && (
				<a class="right" href={nextVersion}>
					Next version ({nextVersion}) <NextIcon />
				</a>
			)
		}
	</nav>
</BaseLayout>

<style lang="scss">
	@use "../../styles/utils" as *;
	@use "../../styles/colors" as *;

	.details {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: size(6);
		padding: 0;
			list-style: none;

		> li,
		> li > p {
			margin: 0;
		}

		[data-icon] {
			font-size: size(20);
		}

		.separator {
			color: var(--color-dimmer);
		}

		.prerelease {
			color: $amber-300;

			@include preferences("light") {
				color: $yellow-700;
			}
		}
	}

	.older-since {
		font-weight: 400;
		color: var(--color-dim);
	}

	nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		margin-block: size(16);

		&:first-child {
			margin-bottom: 0;
		}

		&:not(:first-child) {
			margin-top: 0;
		}

		a {
			display: flex;
			align-items: center;
			gap: size(6);
			padding-block: size(6);

			[data-icon] {
				font-size: size(24);
			}
		}

		.right {
			margin-left: auto;
		}
	}
</style>
