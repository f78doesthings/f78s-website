import BaseLayout from "../layouts/BaseLayout.astro";
import Link from "../components/nav/Link";
import {
	GIT_BRANCH,
	GIT_COMMIT,
	GIT_COMMIT_DATE,
	SITE_VERSION,
	SITE_REPOSITORY,
} from "astro:env/client";
import FormattedDate from "../components/FormattedDate.astro";
import Badge from "../components/Badge";
import { joinURL } from "../scripts/utils";

import VersionIcon from "~icons/octicon/package-24";
import DateIcon from "~icons/octicon/calendar-24";
import BranchIcon from "~icons/octicon/git-branch-24";
import CommitIcon from "~icons/octicon/git-commit-24";
import HistoryIcon from "~icons/octicon/history-16";
import EnvironmentIcon from "~icons/octicon/codespaces-24";
import GithubIcon from "~icons/octicon/mark-github-24";
import IssuesIcon from "~icons/octicon/issue-opened-16";
---

<BaseLayout title={"Version information"}>
	<h1>Version <Badge type="beta" /></h1>
	<p>
		Below is a table of some version information for the website.<br />
		<small
			>For changelogs, you'll have to refer to the <Link
				href={joinURL(SITE_REPOSITORY, "commits", GIT_COMMIT)}
				><HistoryIcon width={16} /> commit history</Link
			> for the time being. I'll work out a solution later.
		</small>
		<div class="version-table">
			<div>
				<VersionIcon />
				<span class="title">Semantic version</span>
				<span>
					<code>{SITE_VERSION}</code>{" "}
					<small>(take this with a grain of salt)</small>
				</span>
			</div>
			<FormattedDate date={new Date(GIT_COMMIT_DATE)} showTime>
				<DateIcon slot="icon" />
				<span class="title" slot="before">Dated</span>
			</FormattedDate>
			<div>
				<BranchIcon />
				<span class="title">Branch</span>
				{
					/* prettier-ignore */
					GIT_BRANCH ? (
						<Link href={joinURL(SITE_REPOSITORY, "tree", GIT_BRANCH)} external><code>{GIT_BRANCH}</code></Link>
					) : (
						<strong>Unknown</strong>
					)
				}
			</div>
			<div>
				<CommitIcon />
				<span class="title">Commit</span>
				<Link href={joinURL(SITE_REPOSITORY, "commit", GIT_COMMIT)} external
					><code>{GIT_COMMIT}</code></Link
				>
			</div>
			<div>
				<EnvironmentIcon />
				<span class="title">Environment</span>
				<code>{import.meta.env.MODE}</code>
			</div>
		</div>

		<h2>Source code</h2>
		<p>
			The source code for this website is available on <Link href={SITE_REPOSITORY} external
				><GithubIcon /> GitHub</Link
			> under <strong>version 2.0 of the Mozilla Public License</strong>. That's also where you can
			report any <Link href={joinURL(SITE_REPOSITORY, "issues")} external
				><IssuesIcon width={16} height={16} /> issues</Link
			> you run into.
		</p>
	</p>

	<style lang="scss">
		@use "../styles/utils" as *;

		.version-table {
			display: grid;
			grid-template-columns: auto auto 1fr;
			column-gap: size(10);

			[data-icon] {
				font-size: size(24);
				vertical-align: middle;
				color: var(--color-dim);
			}

			.title {
				color: var(--color-dim);
				margin-right: size(6);
			}

			> * {
				display: grid;
				grid-template-columns: subgrid;
				grid-column: 1 / -1;
				place-items: center start;

				box-sizing: content-box;
				margin: 0;
				padding: size(10) size(16);
				height: size(24);

				&:nth-child(odd) {
					background-color: hsl(0deg 0% 50% / 12%);
					border-block: 1px solid var(--color-border);
				}
			}
		}
	</style>
</BaseLayout>
