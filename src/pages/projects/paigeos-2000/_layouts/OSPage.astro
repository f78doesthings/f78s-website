import BaseLayout, { type Props } from "../../../../layouts/BaseLayout.astro";
import "../styles/os-styles.scss";
---

<BaseLayout {...Astro.props} fonts="os">
	<slot />
</BaseLayout>

<style lang="scss">
	@use "../../../../styles/utils" as *;
	@use "../styles/common" as *;

	:root {
		font-family: var(--font-os-serif);
		padding-inline: 0.5rem;

		@include preferences("dark") {
			background-color: $color-background-dark;
			color: white;
		}
	}

	:global(a > .external-icon) {
		margin-left: size(4, true);
		margin-top: size(2, true);
		margin-right: 0;
		vertical-align: top;

		font-size: size(12);
		shape-rendering: crispedges;
	}
</style>

<script>
	document.documentElement.classList.add("loaded");
	if (parent !== window) {
		window.addEventListener("focus", () => {
			parent.postMessage("os:focus", parent.location.origin);
		});
	}
</script>
