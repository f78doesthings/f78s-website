import Font from "astro/components/Font.astro";
import "modern-normalize/modern-normalize.css";
import "../styles/general.scss";
import {
	BLOG_TITLE,
	IS_DEV,
	LICENSES,
	SITE_AUTHOR,
	SITE_LANGUAGE,
	SITE_TITLE,
} from "../consts.tsx";
import Header from "../components/nav/Header.astro";
import { ClientRouter } from "astro:transitions";
import FormattedDate from "../components/FormattedDate.astro";
import Link from "../components/nav/Link.tsx";
import type { ImageMetadata, MarkdownLayoutProps } from "astro";
import LastUpdatedIcon from "~icons/fluent/calendar-clock-20-regular";
import ConstructionEmoji from "~icons/noto/construction";
import DragonEmoji from "~icons/noto/dragon";
import Banner from "../components/Banner.astro";
import { SITE_BRANCH } from "astro:env/client";
import { ImmersiveBackground } from "../components/background/ImmersiveBackground";

interface Props extends Partial<
	Omit<MarkdownLayoutProps<Record<string, unknown>>, "rawContent" | "compiledContent">
> {
	/** The title of the page. */
	title?: string;

	/** A description of the page. */
	description?: string;

	/** The image to display in embeds. */
	image?: ImageMetadata;

	/**
	 * Whether this page is part of the blog.
	 *
	 * This currently only changes the site title displayed in the `<title>` tag to the blog's name.
	 */
	isBlog?: boolean;

	/** When this page was last updated. */
	lastModified?: Date;
}

const {
	title,
	description,
	image,
	isBlog = false,
	lastModified,
	headings,
	frontmatter,
} = Astro.props;

let siteTitle = isBlog ? BLOG_TITLE : SITE_TITLE;
const url = new URL(Astro.url);
if (IS_DEV) {
	siteTitle += " [DEV BUILD]";
	url.hostname = "dev.f78.be";
}

let lastModifiedDate = lastModified;
if (!lastModifiedDate && typeof frontmatter?.lastModified === "string") {
	lastModifiedDate = new Date(frontmatter.lastModified);
}

const contentLicense = LICENSES["CC-BY-SA-4.0"];
const LicenseIcons = contentLicense.icons ?? (() => undefined);
---

<!doctype html>
<html lang={SITE_LANGUAGE}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={BLOG_TITLE}
			href={new URL("rss.xml", Astro.site)}
		/>
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<!-- Meta -->
		<title>{(title ? `${title} · ` : "") + siteTitle}</title>
		<meta name="title" content={title ?? siteTitle} />
		<meta name="description" content={description} />
		<meta name="author" content={SITE_AUTHOR} />
		<meta name="generator" content={Astro.generator} />

		{/* Mainly for Discord embeds */}
		<meta name="theme-color" content="#f11325" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{image && <meta property="og:image" content={new URL(image.src, url)} />}

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		{image && <meta property="twitter:image" content={new URL(image.src, url)} />}

		{/* The first 2 fonts are guaranteed to be on every page, so we want to preload them */}
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-heading" preload />
		<Font cssVariable="--font-mono" />
		<Font cssVariable="--font-serif" />
		<ClientRouter />

		<slot name="head" />
	</head>
	<body>
		<div class="loading-bar" transition:persist></div>

		<Header headings={headings} />

		{
			/* prettier-ignore */
			IS_DEV ? (
				<Banner id="dev">
					<DragonEmoji />
					<span>
						This is a
						<Link href={`https://github.com/f78doesthings/f78s-website/tree/${SITE_BRANCH}`} external>development build</Link>
						of the website. Issues are to be expected, and should be reported on
						<Link href="https://github.com/f78doesthings/f78s-website/issues" external>GitHub</Link>.
					</span>
				</Banner>
			) : (
				<Banner id="under-construction">
					<ConstructionEmoji />
					<span>
						This newly revamped version of the website is still being worked on. Report any bugs you
						find on
						<Link href="https://github.com/f78doesthings/f78s-website/issues" external>GitHub</Link>.
					</span>
				</Banner>
			)
		}

		<main>
			<slot />
		</main>

		<footer>
			{
				lastModifiedDate && (
					<FormattedDate date={lastModifiedDate}>
						<LastUpdatedIcon slot="icon" />
						<Fragment slot="before">Last updated:</Fragment>
					</FormattedDate>
				)
			}
			<slot name="footer" />
			<p>
				<small>
					The content of this site is available under the
					<Link href={LICENSES["CC-BY-SA-4.0"].url} external>
						<LicenseIcons />
						{contentLicense.title}
					</Link>
					licence.
				</small>
			</p>
			{/* TODO: can I add a link to the page's source code on GitHub here? */}
		</footer>

		<ImmersiveBackground client:only="preact" transition:persist />
		<div class="debug-display" transition:persist></div>
		<div id="media-viewer-root"></div>
	</body>
</html>

<script src="../scripts/client-init.ts"></script>
