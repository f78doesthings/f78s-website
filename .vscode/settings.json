{
	// Linting
	"astro.content-intellisense": true,
	"markdown.validate.enabled": true,
	"markdown.validate.ignoredLinks": ["../main", "../dev"],
	"stylelint.validate": ["css", "postcss", "scss", "astro"],
	"css.validate": false,
	"scss.validate": false,

	// Formatting
	"editor.insertSpaces": false,
	"editor.rulers": [100],
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"[astro]": {
		"editor.defaultFormatter": "astro-build.astro-vscode"
	},
	// TODO: Oxfmt seems to have some troubles with MDX files, is there maybe a better alternative?
	"[mdx]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},

	// Spellcheck (optional, requires Code Spell Checker w/ British English dictionary and/or LTeX+)
	"cSpell.language": "en-GB",
	"ltex.language": "en-GB",
	// Don't bother using this extension's spell check,
	// because it creates too many false positives in MDX files
	"ltex.disabledRules": { "en-GB": ["MORFOLOGIK_RULE_EN_GB"] },

	// Copyright (WIP, requires psioniq File Header)
	"psi-header.config": {
		"forceToTop": true,
		"blankLinesAfter": 1,
		"author": "f78",
		"license": "MPL-2.0"
	},
	"psi-header.changes-tracking": {
		"isActive": true,
		"enforceHeader": true,
		"excludeGlob": [
			"**/settings.json",
			"**/.gitignore",
			"**/.gitattributes",
			"**/.gitmodules",
			"**/*.config.*",
			"**/.ncurc.*"
		],
		"exclude": ["json", "jsonc", "plaintext", "markdown", "mdx"]
	},
	"psi-header.templates": [
		{
			"language": "*",
			"template": [
				"Copyright (c) <<year>> <<author>>.",
				"",
				"This Source Code Form is subject to the terms of the Mozilla Public",
				"License, v. 2.0. If a copy of the MPL was not distributed with this",
				"file, You can obtain one at https://mozilla.org/MPL/2.0/."
			]
		}
	],
	"psi-header.lang-config": [
		{
			// BUG: this likes to insert a bogus --- after the header
			"language": "astro",
			"beforeHeader": ["---"]
		},
		{
			// Mimic WebStorm's behaviour
			"language": "scss",
			"begin": "/*!"
		}
	]
}
